<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Only for builds signed without a Team ID (ad-hoc or self-signed, through SIGN_IDENTITY): the hardened runtime's
	     library validation would refuse to load the embedded Sparkle.framework. Developer ID builds don't use this
	     file. DYLD_* environment variables stay blocked. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
